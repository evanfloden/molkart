nextflow_process {
    name "Test Process MASKFILTER"
    script "../main.nf"
    process "MASKFILTER"
}

test("Should run without failures") {

    when {
        process {
            """
            input[0] = [
                [ id:'test', single_end:false ], // meta map
                file(params.test_data['imaging']['mask'])
            ]
            """
        }
    }

    then {
        assert process.success
        assert snapshot(process.out).match()

        with(process.out.filtered_mask) {
            assert size() == 1
            assert path(get(0)[1]).exists()
            assert path(get(0)[1]).getName().endsWith(".tif")
        }

        with(process.out.filtered_qc) {
            assert size() == 1
            assert path(get(0)[1]).exists()
            assert path(get(0)[1]).getName().endsWith(".csv")
        }

        with(process.out.versions) {
            assert size() == 1
            assert path(get(0)).exists()
            assert path(get(0)).getText().contains("molkart_maskfilter")
        }
    }
}

test("Should run with custom prefix") {

    when {
        process {
            """
            input[0] = [
                [ id:'test2', single_end:false ], // meta map
                file(params.test_data['imaging']['mask'])
            ]
            ext.prefix = 'custom_prefix'
            """
        }
    }

    then {
        assert process.success
        assert snapshot(process.out).match()

        with(process.out.filtered_mask) {
            assert size() == 1
            assert path(get(0)[1]).getName() == "custom_prefix.tif"
        }

        with(process.out.filtered_qc) {
            assert size() == 1
            assert path(get(0)[1]).getName() == "custom_prefix.csv"
        }
    }
}

test("Should run in stub mode") {

    when {
        process {
            """
            input[0] = [
                [ id:'test3', single_end:false ],
                file(params.test_data['imaging']['mask'])
            ]
            """
        }
    }

    then {
        assert process.success
        assert snapshot(process.out).match()

        with(process.out.filtered_mask) {
            assert size() == 1
            assert path(get(0)[1]).exists()
        }
    }

    stub()
}}
